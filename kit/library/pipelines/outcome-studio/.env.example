# outcome-studio (studio/*.py, newsdesk/vcn.py, research-tools/*): settings read from the environment. All optional.
# The scripts read os.environ only (they do not load this file): export these in your shell.

# Chrome binary for headless rendering and page capture (default: the standard Windows or Mac install path)
CHROME_PATH=
# Folder of the premiere-ae-editing skill's scripts (default ~/.claude/skills/premiere-ae-editing/scripts)
PAE_SCRIPTS=
# Extra font folders for newsdesk/vcn.py, ":"-separated on a Mac
VC_FONT_DIRS=
# Google Drive folder for the Outcome pages ("newsdesk/vcn.py drive"). Deliberately separate from the rap pages' VC_DRIVE_DIR.
OUTCOME_DRIVE_DIR=
# research-tools/textmetrics.py: folder holding data/refs.jsonl (default: the original research folder on Kanishk's PC)
TEXTMETRICS_ROOT=

# No API keys are read by any script here. Public data only (Hyperliquid info API, Outcome's public endpoints, ESPN JSON).
# Optional accounts mentioned in the research, not wired in: Pexels and Pixabay API keys, a Freesound account.
