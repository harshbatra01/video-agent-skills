# edits-kit (tools/*.py): settings read from the environment. All optional. Export them in your shell.

# Folder of the premiere-ae-editing skill's scripts (ae_build.py, ytdl.py, beats.py, hear.py live there)
# default ~/.claude/skills/premiere-ae-editing/scripts
PAE_SCRIPTS=
# Extra font folders for tools/typeset.py (":"-separated on a Mac). Fonts activated through Adobe Fonts have no
# normal file path, so install the .otf/.ttf files or point here at a folder that holds them.
FONT_DIRS=

# No API keys. Model weights (SAM 2, open_clip ViT-L-14) download from their public sources on first use.
