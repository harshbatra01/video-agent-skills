# newsdesk (vcn.py, scan.py, fetch.py): settings read from the environment. All optional; empty = the built-in default.
# The scripts read os.environ only (they do not load this file): export these in your shell, e.g. in ~/.zshrc.
# Never put real secrets in a file that ships with the kit.

# Folder of the premiere-ae-editing skill's scripts (default ~/.claude/skills/premiere-ae-editing/scripts)
PAE_SCRIPTS=
# Chrome binary used for headless rendering (default: the standard Windows or Mac install path)
CHROME_PATH=
# Extra font folders, separated by ":" on a Mac (";" on Windows), searched before the system folders
VC_FONT_DIRS=
# Google Drive posting folder for "vcn.py drive" (Mac: ~/Library/CloudStorage/GoogleDrive-<account>/My Drive/RAP POSTS VISION)
VC_DRIVE_DIR=
# Folder holding 03-news-feeds.json for "scan.py --full" (default: ../research, then the kit's research/music-pages)
VC_RESEARCH_DIR=

# Not an environment variable: an OPTIONAL cookies file for YouTube bot-check blocks goes in secrets/youtube_cookies.txt
# (a throwaway account only, never a personal or business account). Nothing in the kit contains one.
# Not read by any script yet (only if the scan moves off fxtwitter / adds Instagram or TikTok): an X API bearer token,
# an Apify token, a Meta Graph token. Each would need his own account.
